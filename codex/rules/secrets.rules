# Block commands whose only purpose is to print a stored credential.
# Agents can still use glab/git normally; they just cannot read the token back.
# Codex writes persisted approvals to default.rules, so these live in their own file.

prefix_rule(
    pattern = ["glab", "auth", "status", ["--show-token", "-t"]],
    decision = "forbidden",
    justification = "Prints the GitLab token stored in the keyring.",
    match = ["glab auth status --show-token", "glab auth status -t"],
    not_match = ["glab auth status"],
)

prefix_rule(
    pattern = ["glab", "config", "get", "token"],
    decision = "forbidden",
    justification = "Prints the GitLab token from glab config.",
    match = ["glab config get token", "glab config get token --host git.example.com"],
    not_match = ["glab config get api_host"],
)

prefix_rule(
    pattern = ["security", "find-generic-password"],
    decision = "forbidden",
    justification = "Reads secrets from the macOS Keychain.",
    match = ["security find-generic-password -s foo -w"],
)
